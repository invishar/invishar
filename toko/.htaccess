# ==========================================================================
# Toko Invishar — halaman publik: link affiliate, checkout, status bayar,
# formulir order, landing page produk, dan webhook Midtrans.
# ==========================================================================

DirectoryIndex disabled
Options -Indexes

# Paksa HTTPS: halaman ini menerima data pembeli.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  # Landing page produk (halaman.php, dibuka lewat /p/nama) boleh diindeks.
  <FilesMatch "^(?!halaman\.php$)">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
