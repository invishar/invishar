# ==========================================================================
# Invishar — konfigurasi Apache untuk hosting Domainesia (cPanel)
# Berkas ini ikut terunggah ke public_html dan dibaca otomatis oleh server.
# ==========================================================================

# --- Halaman utama -------------------------------------------------------
DirectoryIndex index.html

# --- Paksa HTTPS ---------------------------------------------------------
# AKTIF. Sudah diverifikasi bahwa SSL hidup di invishar.com maupun
# www.invishar.com (keduanya menjawab 200 lewat https).
#
# Aturan ini perlu ada di sini karena deploy menimpa .htaccess di
# public_html — tanpa ini, pengalihan http -> https yang sudah berjalan
# bisa ikut hilang saat deploy pertama.
#
# %{HTTP_HOST} dipertahankan apa adanya, jadi www tetap ke www dan
# non-www tetap non-www; sertifikatnya cocok untuk dua-duanya.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Link affiliate --------------------------------------------------------
  # /r/KODE            → beranda
  # /r/KODE/produk     → landing page produk
  # Ditangani toko/r.php: mencatat klik, menanam cookie, lalu mengalihkan.
  RewriteRule ^r/([A-Za-z0-9]{4,16})(?:/([a-z0-9-]+))?/?$ toko/r.php?kode=$1&p=$2 [L,QSA]

  # --- Landing page produk ---------------------------------------------------
  # /p/nama-produk → toko/halaman.php: HTML custom unggahan admin (bersandbox),
  # atau templat bawaan produk.html yang mengisi diri dari data/produk.json.
  RewriteRule ^p/([a-z0-9-]+)/?$ toko/halaman.php?slug=$1 [L,QSA]

  # --- Formulir order produk -------------------------------------------------
  # /order/nama-produk → checkout, aplikasi tujuan, atau formulir permintaan.
  # Tujuan tombol {{ORDER}} di landing page custom.
  RewriteRule ^order/([a-z0-9-]+)/?$ toko/order.php?p=$1 [L,QSA]
</IfModule>

# --- Kompresi ------------------------------------------------------------
# Memperkecil ukuran kiriman HTML/CSS/JS, halaman terasa lebih cepat.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache browser -------------------------------------------------------
# Aset disimpan lama di browser pengunjung; HTML sengaja pendek supaya
# perubahan teks langsung terlihat setelah deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# --- Keamanan dasar ------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sembunyikan daftar isi folder kalau tidak ada index.html di dalamnya.
Options -Indexes

# Jangan sajikan berkas catatan deploy ke publik.
<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  Require all denied
</FilesMatch>
